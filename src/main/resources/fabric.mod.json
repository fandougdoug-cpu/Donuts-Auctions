{
  "schemaVersion": 1,
  "id": "donutsauctions",
  "version": "${version}",
  "name": "DonutsAuctions",
  "description": "Client-side DonutSMP auction price history, deal alerts, and investment calculators.",
  "icon": "assets/donutsauctions/AutionMaster-Icon.jpeg",
  "authors": [
    "cancelcloud",
    "fandougdoug-cpu"
  ],
  "contact": {
    "homepage": "https://github.com/fandougdoug-cpu/Donuts-Auctions",
    "issues": "https://github.com/fandougdoug-cpu/Donuts-Auctions/issues",
    "sources": "https://github.com/fandougdoug-cpu/Donuts-Auctions"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "de.lukas.donutsauctions.DonutsAuctionsClient"
      }
    ],
    "modmenu": [
      "de.lukas.donutsauctions.config.DonutsAuctionsModMenuIntegration"
    ]
  },
  "mixins": [
    "donutsauctions.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "modmenu": ">=${modmenu_version}",
    "cloth-config2": ">=${cloth_config_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
